<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="kotlin.Unit" />

        <variable
            name="sort"
            type="String" />

        <variable
            name="gasStationInfo"
            type="org.techtown.find_gas_station.data.TotalOilInfo" />

        <variable
            name="moveKakaoBtnClick"
            type="kotlin.jvm.functions.Function0" />

        <variable
            name="moveStationDetailBtnClick"
            type="kotlin.jvm.functions.Function1&lt;org.techtown.find_gas_station.data.TotalOilInfo, Unit>" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/white">

        <ImageView
            android:id="@+id/oil_image"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="5dp"
            android:contentDescription="@string/gas_station_img"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:setImg="@{gasStationInfo.image}" />

        <TextView
            android:id="@+id/oil_kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:text="@{gasStationInfo.oilKind}"
            android:textColor="@color/app_background"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/oil_image"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@{gasStationInfo.name}"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/oil_kind"
            app:layout_constraintStart_toEndOf="@+id/oil_kind"
            app:layout_constraintTop_toTopOf="@+id/oil_kind" />

        <TextView
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:gravity="center_vertical"
            android:text="@{gasStationInfo.price}"
            android:textColor="#000000"
            android:textSize="35sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/oil_image"
            app:layout_constraintTop_toBottomOf="@+id/oil_kind" />

        <TextView
            android:id="@+id/won"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/won"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@+id/price"
            app:layout_constraintStart_toEndOf="@+id/price" />

        <TextView
            android:id="@+id/distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="#4CAF50"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/price"
            app:layout_constraintStart_toEndOf="@+id/won"
            app:sort="@{sort}"
            app:totalOilInfo="@{gasStationInfo}" />

        <TextView
            android:id="@+id/navi_button_kakao"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/kaka_navi_background"
            android:gravity="center"
            android:onClick="@{() -> moveKakaoBtnClick.invoke()}"
            android:text="@string/navi"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/navi_blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/intelButton" />

        <ImageButton
            android:id="@+id/intelButton"
            android:layout_width="60dp"
            android:layout_height="50dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/gas_station_detail_background"
            android:contentDescription="@string/gas_station_info_detail"
            android:onClick="@{() -> moveStationDetailBtnClick.invoke(gasStationInfo)}"
            android:src="@drawable/gas"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/navi_button_kakao" />


        <ImageView
            android:id="@+id/carWashStore"
            android:layout_width="30dp"
            android:layout_height="25dp"
            android:contentDescription="@string/car_wash_exist"
            app:layout_constraintBottom_toTopOf="@+id/intelButton"
            app:layout_constraintStart_toStartOf="@+id/intelButton"
            app:setCarWashImg="@{gasStationInfo.carWash}" />

        <ImageView
            android:id="@+id/conStore"
            android:layout_width="30dp"
            android:layout_height="25dp"
            android:contentDescription="@string/convenience_store_exist"
            app:layout_constraintBottom_toBottomOf="@+id/carWashStore"
            app:layout_constraintStart_toEndOf="@+id/carWashStore"
            app:layout_constraintTop_toTopOf="@+id/carWashStore"
            app:setConStoreImg="@{gasStationInfo.conStore}" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#aaa"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
